{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "MinGW 13.1 + Qt 6.12.0 (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.12.0/mingw_64",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/Ninja/ninja.exe",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_RC_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/windres.exe"
      }
    },
    {
      "name": "mingw-debug",
      "inherits": "mingw",
      "displayName": "MinGW Debug",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc",
      "displayName": "MSVC 2026 + Qt 6.12.0 (WebEngine Quick Login)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.12.0/msvc2022_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "mingw", "configurePreset": "mingw" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Release" }
  ]
}
