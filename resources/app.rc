/* Application icon for Copper Steam Idler */
IDI_ICON1 ICON "app.ico"

/* Use numeric resource id 1 (VS_VERSION_INFO). The named form only resolves to 1
   when <windows.h> is included; without it windres stores a string id that
   Windows/.NET cannot read, leaving the file version blank in Explorer. */
1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Copper Steam Idler"
            VALUE "FileDescription", "Copper Steam Idler"
            VALUE "FileVersion", "0.2.0.0"
            VALUE "InternalName", "CopperSteamIdler"
            VALUE "OriginalFilename", "CopperSteamIdler.exe"
            VALUE "ProductName", "Copper Steam Idler"
            VALUE "ProductVersion", "0.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
